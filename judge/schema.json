{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "additionalProperties": false,
 "properties": {
  "candidates": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "feature_refs": {
      "items": {
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "entry": {
        "type": "number"
       },
       "risk_frac": {
        "type": "number"
       },
       "stop": {
        "type": "number"
       },
       "targets": {
        "items": {
         "type": "number"
        },
        "minItems": 1,
        "type": "array"
       },
       "void_if": {
        "type": "string"
       },
       "order_type": {
        "enum": [
         "market",
         "limit"
        ],
        "default": "market",
        "description": "限价单按 core 限价口径回放：穿越才成交、未成交留档"
       },
       "void": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "level": {
          "type": "number"
         },
         "side": {
          "enum": [
           "above",
           "below"
          ]
         }
        },
        "required": [
         "level",
         "side"
        ],
        "description": "结构化前提失效：生命周期内任一根收盘越过 level（side 指失效侧）即按收盘价出场，回放强制执行；void_if 文字说明与此并存，冲突时以结构化为准"
       },
       "second_bar_confirmed": {
        "type": "boolean",
        "default": false,
        "description": "入场方式声明：触发后已见第二根确认（判断层声明、裁决层 S2 查验）；非感知量，不许事后补填"
       }
      },
      "required": [
       "entry",
       "stop",
       "targets",
       "void_if",
       "risk_frac"
      ],
      "type": [
       "object",
       "null"
      ]
     },
     "qualified": {
      "type": "boolean"
     },
     "reason": {
      "type": "string"
     },
     "setup": {
      "enum": [
       "B1",
       "B2",
       "B3",
       "A1",
       "A2",
       "C1"
      ],
      "type": "string"
     },
     "side": {
      "enum": [
       "long",
       "short"
      ],
      "type": "string"
     }
    },
    "required": [
     "setup",
     "side",
     "qualified",
     "reason",
     "feature_refs"
    ],
    "type": "object"
   },
   "type": "array"
  },
  "hypotheses": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "holds_if": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "menu": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "statement": {
      "type": "string"
     },
     "takeover_if": {
      "description": "备选升为主的触发事实；主假设填空字符串",
      "type": "string"
     },
     "void_if": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "statement",
     "holds_if",
     "void_if",
     "takeover_if",
     "menu"
    ],
    "type": "object"
   },
   "maxItems": 3,
   "minItems": 1,
   "type": "array"
  },
  "no_trade_reason": {
   "enum": [
    null,
    "无命中",
    "位置不对",
    "成色不合格",
    "背景不明",
    "感知未定"
   ],
   "type": [
    "string",
    "null"
   ]
  },
  "pending_conditions": {
   "description": "候选挂起时写明重新合格的条件",
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "primary": {
   "description": "主假设编号，如 H1",
   "type": "string"
  },
  "uncertainty": {
   "description": "本次判断依赖的、置信为边界/未定的特征字段名",
   "items": {
    "type": "string"
   },
   "type": "array"
  }
 },
 "required": [
  "primary",
  "hypotheses",
  "candidates",
  "uncertainty"
 ],
 "title": "PAJudgment",
 "type": "object"
}